{
  "name": "cmdream-studio",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "Command-line art in motion.",
  "homepage": "https://github.com/official-mano/cmdream-studio",
  "author": {
    "name": "CMDream Studio contributors",
    "email": "254135522+official-mano@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "dist:windows": "npm run build && electron-builder --win nsis portable --x64 && electron-builder --win nsis portable --arm64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 && electron-builder --mac dmg zip --arm64",
    "update:release-catalog": "node scripts/update-release-catalog.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^6.2.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "build": {
    "appId": "studio.cmdream.app",
    "productName": "CMDream Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/cmdream-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "CMDream-Studio-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "CMDream-Studio-${version}-Portable-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/cmdream-icon.png",
      "maintainer": "CMDream Studio contributors <254135522+official-mano@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "artifactName": "CMDream-Studio-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/cmdream-icon.icns",
      "category": "public.app-category.graphics-design",
      "artifactName": "CMDream-Studio-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
